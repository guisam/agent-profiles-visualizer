# Dev server defaults. Override them in .env.development.local (not committed).
#
# Until guisam/Agent-Profiles#124 adds `visualize --allow-origin`, the live API
# rejects requests from http://localhost:3000, so the dev server answers from
# recorded responses in src/fixtures.
VITE_AP_FIXTURES=true
# Which recorded project to show: a folder in src/fixtures.
VITE_AP_FIXTURE_SET=default

# To use a live server instead, put these in .env.development.local:
# VITE_AP_FIXTURES=false
# VITE_AP_SESSION_URL=http://127.0.0.1:4790/<token>/
